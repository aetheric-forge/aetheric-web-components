<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
    aetheric-provisioning's engine now lives inside aetheric-runtime (src/Provisioning/), reached
    here through the runtime submodule. No override property is needed anymore - this repo's own
    sample host (samples/Aetheric.Provisioning.Web) references this project directly as a sibling,
    so there's only ever one copy of these assemblies within this repo's build graph.
  -->
  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../runtime/src/Provisioning/Aetheric.Provisioning.Simulation/Aetheric.Provisioning.Simulation.csproj" />
    <ProjectReference Include="../../runtime/src/Provisioning/Aetheric.Provisioning.Application/Aetheric.Provisioning.Application.csproj" />
    <ProjectReference Include="../../runtime/src/Provisioning/Aetheric.Provisioning.Registry/Aetheric.Provisioning.Registry.csproj" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" /></ItemGroup>
</Project>

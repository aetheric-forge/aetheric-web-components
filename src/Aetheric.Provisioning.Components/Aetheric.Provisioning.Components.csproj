<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
    RuntimeRoot defaults to this repo's own runtime submodule, for standalone builds. A host
    that already has aetheric-runtime checked out natively (e.g. aetheric-admin, which needs the
    rest of aetheric-runtime for its own campus composition regardless of this library) should
    override it via AdditionalProperties on its ProjectReference to point at that native checkout
    instead - otherwise the build pulls in a second, independently-built copy of
    Application/Engine/Registry/Simulation alongside the host's own, which are different
    assemblies despite identical source and will not satisfy each other's types at
    DI-resolution time. Same hazard, same fix, as the ProvisioningRoot property this replaced.
  -->
  <PropertyGroup>
    <RuntimeRoot Condition="'$(RuntimeRoot)' == ''">../../runtime</RuntimeRoot>
  </PropertyGroup>
  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RuntimeRoot)/src/Provisioning/Aetheric.Provisioning.Simulation/Aetheric.Provisioning.Simulation.csproj" />
    <ProjectReference Include="$(RuntimeRoot)/src/Provisioning/Aetheric.Provisioning.Application/Aetheric.Provisioning.Application.csproj" />
    <ProjectReference Include="$(RuntimeRoot)/src/Provisioning/Aetheric.Provisioning.Registry/Aetheric.Provisioning.Registry.csproj" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" /></ItemGroup>
</Project>

# Keycloak server base URL (without /realms/...). No client secret belongs here.
KEYCLOAK_AUTHORITY=https://sso.example.com
KEYCLOAK_REALM=root
KEYCLOAK_CLIENT_ID=provisioner
# Service account must have realm-management / realm-admin in its access token.

# Dedicated non-composite realm role for the new Forge administrator.
FORGE_ADMIN_ROLE=forge-admin

# Public origin for the new administrator’s SSO. Development defaults to http://127.0.0.1:5180.
PROVISIONER_PUBLIC_ORIGIN=
